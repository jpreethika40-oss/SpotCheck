generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FACILITY_MANAGER
  INSPECTOR
  MAINTENANCE_TECHNICIAN
}

enum FacilityType {
  COMMERCIAL
  INDUSTRIAL
  HEALTHCARE
  EDUCATIONAL
  RESIDENTIAL
  WAREHOUSE
}

enum AssetCategory {
  HVAC
  ELECTRICAL
  PLUMBING
  FIRE_SAFETY
  STRUCTURAL
  ELEVATOR
  SECURITY
  OTHER
}

enum AssetStatus {
  OPERATIONAL
  NEEDS_ATTENTION
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  FLAGGED
}

enum SyncStatus {
  SYNCED
  PENDING
  CONFLICT
  FAILED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkOrderStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFIED
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum UploadStatus {
  PENDING
  UPLOADING
  COMPLETED
  FAILED
}

model User {
  id           String    @id @default(uuid()) @map("_id")
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole  @default(INSPECTOR)
  isActive     Boolean   @default(true)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions           UserSession[]
  assignedFacilities UserFacilityAssignment[]
  inspections        Inspection[]
  reportedIssues     Issue[]                  @relation("ReportedByUser")
  assignedIssues     Issue[]                  @relation("AssignedToUser")
  verifiedIssues     Issue[]                  @relation("VerifiedByUser")
  workOrderEvents    WorkOrderEvent[]
  schedules          InspectionSchedule[]
  auditEvents        AuditEvent[]
  notifications      AppNotification[]

  @@index([role])
}

model UserSession {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Facility {
  id           String       @id @default(uuid()) @map("_id")
  name         String
  code         String       @unique
  type         FacilityType @default(COMMERCIAL)
  address      String
  city         String
  state        String
  postalCode   String
  squareMeters Float?
  contactName  String?
  contactEmail String?
  contactPhone String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  zones         Zone[]
  checkpoints   Checkpoint[]
  assets        Asset[]
  inspections   Inspection[]
  issues        Issue[]
  schedules     InspectionSchedule[]
  assignedUsers UserFacilityAssignment[]

  @@index([name])
}

model UserFacilityAssignment {
  id         String   @id @default(uuid()) @map("_id")
  userId     String
  facilityId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId])
  @@index([userId])
  @@index([facilityId])
}

model Zone {
  id          String   @id @default(uuid()) @map("_id")
  facilityId  String
  name        String
  code        String
  floor       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  checkpoints Checkpoint[]
  assets      Asset[]
  inspections Inspection[]
  issues      Issue[]

  @@unique([facilityId, code])
  @@index([facilityId])
}

model Checkpoint {
  id                  String   @id @default(uuid()) @map("_id")
  zoneId              String
  facilityId          String
  name                String
  code                String
  qrCodeToken         String   @unique
  locationDescription String?
  instructions        String?
  sequenceOrder       Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  zone        Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  assets      Asset[]
  inspections Inspection[]
  issues      Issue[]

  @@unique([zoneId, code])
  @@index([zoneId])
  @@index([facilityId])
}

model Asset {
  id               String        @id @default(uuid()) @map("_id")
  facilityId       String
  zoneId           String?
  checkpointId     String?
  name             String
  assetTag         String        @unique
  category         AssetCategory @default(OTHER)
  modelNumber      String?
  serialNumber     String?
  manufacturer     String?
  installationDate DateTime?
  status           AssetStatus   @default(OPERATIONAL)
  criticality      Criticality   @default(MEDIUM)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  zone        Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  checkpoint  Checkpoint?  @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  inspections Inspection[]
  issues      Issue[]

  @@index([facilityId])
}

model InspectionTemplate {
  id           String        @id @default(uuid()) @map("_id")
  name         String
  description  String?
  facilityType FacilityType?
  version      Int           @default(1)
  isLatest     Boolean       @default(true)
  isActive     Boolean       @default(true)
  fieldsJson   Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  inspections Inspection[]
  schedules   InspectionSchedule[]

  @@index([name])
  @@index([version])
}

model InspectionSchedule {
  id           String            @id @default(uuid()) @map("_id")
  facilityId   String
  templateId   String
  assignedToId String?
  frequency    ScheduleFrequency @default(WEEKLY)
  nextDueDate  DateTime
  lastRunDate  DateTime?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  facility   Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  template   InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignedTo User?              @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([facilityId])
  @@index([nextDueDate])
}

model Inspection {
  id               String           @id @default(uuid()) @map("_id") // Client-generated UUID or generated
  templateId       String
  templateVersion  Int
  facilityId       String
  zoneId           String?
  checkpointId     String?
  assetId          String?
  inspectorId      String
  status           InspectionStatus @default(DRAFT)
  startedAt        DateTime
  completedAt      DateTime?
  summaryNotes     String?
  weatherCondition String?
  itemsJson        Json
  version          Int              @default(1) // Concurrency token
  syncStatus       SyncStatus       @default(SYNCED)
  idempotencyKey   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  template   InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  facility   Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  zone       Zone?              @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  checkpoint Checkpoint?        @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  asset      Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  inspector  User               @relation(fields: [inspectorId], references: [id], onDelete: Restrict)
  issues     Issue[]

  @@index([facilityId])
  @@index([inspectorId])
  @@index([status])
  @@index([createdAt])
}

model Issue {
  id                    String          @id @default(uuid()) @map("_id") // Client-generated UUID or generated
  facilityId            String
  zoneId                String?
  checkpointId          String?
  assetId               String?
  inspectionId          String?
  title                 String
  description           String
  category              String
  severity              IssueSeverity   @default(MEDIUM)
  reportedById          String
  status                WorkOrderStatus @default(REPORTED)
  assignedToId          String?
  dueDate               DateTime?
  resolutionNotes       String?
  verificationNotes     String?
  verifiedById          String?
  verifiedAt            DateTime?
  evidenceAttachmentIds String[]
  workAttachmentIds     String[]
  version               Int             @default(1) // Concurrency token
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  facility   Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  zone       Zone?            @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  checkpoint Checkpoint?      @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  asset      Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  inspection Inspection?      @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  reportedBy User             @relation("ReportedByUser", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedTo User?            @relation("AssignedToUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  verifiedBy User?            @relation("VerifiedByUser", fields: [verifiedById], references: [id], onDelete: SetNull)
  events     WorkOrderEvent[]

  @@index([facilityId])
  @@index([status])
  @@index([severity])
  @@index([assignedToId])
  @@index([dueDate])
}

model WorkOrderEvent {
  id                    String          @id @default(uuid()) @map("_id")
  issueId               String
  actorId               String
  fromStatus            WorkOrderStatus
  toStatus              WorkOrderStatus
  notes                 String?
  evidenceAttachmentIds String[]
  createdAt             DateTime        @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([issueId])
  @@index([createdAt])
}

model Attachment {
  id             String       @id @default(uuid()) @map("_id") // Client-generated UUID or generated
  filename       String
  contentType    String
  byteSize       Int
  checksumSha256 String?
  storagePath    String
  uploadStatus   UploadStatus @default(PENDING)
  totalChunks    Int          @default(1)
  uploadedChunks Int          @default(0)
  uploaderId     String
  associatedType String
  associatedId   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([associatedId])
  @@index([uploaderId])
  @@index([uploadStatus])
}

model SyncOperationRecord {
  id              String   @id @default(uuid()) @map("_id")
  operationId     String   @unique
  idempotencyKey  String   @unique
  entityType      String
  action          String
  recordId        String
  actorId         String
  clientTimestamp DateTime
  processedAt     DateTime @default(now())
  status          String
  resultJson      Json

  @@index([actorId])
  @@index([recordId])
}

model ConflictRecord {
  id                String    @id @default(uuid()) @map("_id")
  recordId          String
  entityType        String
  actorId           String
  baseVersion       Int
  serverVersion     Int
  clientVersion     Int
  conflictingFields String[]
  resolvedStrategy  String?
  resolvedById      String?
  resolvedAt        DateTime?
  status            String    @default("OPEN")
  payloadLocal      Json
  payloadServer     Json
  createdAt         DateTime  @default(now())

  @@index([recordId])
  @@index([status])
}

model AppNotification {
  id         String   @id @default(uuid()) @map("_id")
  userId     String
  title      String
  message    String
  type       String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditEvent {
  id              String   @id @default(uuid()) @map("_id")
  timestamp       DateTime @default(now())
  actorId         String?
  actorEmail      String?
  actorRole       String?
  action          String
  entityType      String
  entityId        String
  facilityId      String?
  previousVersion Int?
  newVersion      Int?
  details         Json
  ipAddress       String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityId])
  @@index([entityType])
  @@index([actorId])
  @@index([facilityId])
  @@index([timestamp])
}
