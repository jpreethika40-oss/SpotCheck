# Root Environment Template for SpotCheck
# Server environment variables (place in server/.env)
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://spotcheck:spotcheck@127.0.0.1:5432/spotcheck?schema=public
JWT_SECRET=spotcheck_development_jwt_secret_replace_in_production
COOKIE_SECRET=spotcheck_development_cookie_secret_replace_in_production
CORS_ORIGIN=http://localhost:5173
STORAGE_DIR=./uploads

# Client environment variables (Vite dev server proxies /api to http://localhost:5000)
VITE_API_BASE_URL=/api/v1
