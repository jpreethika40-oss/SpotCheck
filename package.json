{
  "name": "spotcheck-platform",
  "version": "1.0.0",
  "description": "Offline-First Facility Inspection & Maintenance Platform",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix shared run build && npm --prefix server run build && npm --prefix client run build",
    "test": "npm --prefix server run test",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:migrate": "npm --prefix server run prisma:push",
    "prisma:push": "npm --prefix server run prisma:push",
    "prisma:seed": "npm --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
